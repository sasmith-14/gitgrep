ES_TIMEOUT_MS=2000
EMBED_CACHE_SIZE=1000
FACET_TTL_MS=60000
RATE_LIMIT=120
RATE_WINDOW_MS=60000
BREAKER_FAILURES=3
BREAKER_RESET_MS=10000
ES_API_KEY=
TRUST_PROXY_HOPS=0
