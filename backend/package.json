{
  "name": "gitgrep-api",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit",
    "integration": "tsx --test tests/*.integration.ts",
    "bench": "tsx ../eval/benchmark.ts",
    "eval": "tsx ../eval/run.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.1.0",
    "pino": "9.7.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "autocannon": "8.0.0",
    "fast-check": "4.1.1",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
